NODE_ENV=development
PORT=3000

APP_NAME=FilaJusta
APP_URL=http://localhost:3000
TIMEZONE=America/Manaus

# Banco de dados. Em producao prefira DATABASE_URL (uma unica URL entregue pelo provedor).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filajusta
DB_USER=filajusta
DB_PASSWORD=sua-senha-aqui
DB_DIALECT=postgres
DB_LOGGING=false
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Provedores em nuvem normalmente exigem SSL: DB_SSL=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Em producao: minimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# CORS_ORIGIN deve ser exatamente a URL do frontend (sem barra no final). Obrigatorio em producao.
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Recuperacao de senha por e-mail
RECOVERY_CODE_EXPIRES_MINUTES=10
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_RATE_LIMIT_MAX=20

# E-mail (SMTP) usado para enviar o codigo de recuperacao.
# Sem SMTP_HOST em desenvolvimento, o codigo aparece no log do servidor.
# Sem SMTP_HOST em producao, a recuperacao responde 503.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true usa TLS direto (porta 465). Em 587 deixe vazio/false (STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FilaJusta <seu-email@exemplo.com>

# Senha dos usuarios criados pelo seed (admin e recepcao). Padrao: 123456.
# Em ambiente publicado, defina uma senha propria.
# SEED_SENHA_PADRAO=

# Docker: RUN_MIGRATIONS=true aplica as migrations ao iniciar o container.
# RUN_MIGRATIONS=true

UPLOAD_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=10

LOG_LEVEL=info
