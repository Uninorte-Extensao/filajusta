NODE_ENV=development
PORT=3000

APP_NAME=FilaJusta
APP_URL=http://localhost:3000
TIMEZONE=America/Manaus

DB_HOST=localhost
DB_PORT=5432
DB_NAME=filajusta
DB_USER=filajusta
DB_PASSWORD=filajusta
DB_DIALECT=postgres
DB_LOGGING=false

JWT_SECRET=change-me-super-secret
